rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validTransaction(id) {
      let d = request.resource.data;
      return d.id == id
        && d.kind in ['expense', 'moneyIn']
        && d.amountPaise is int && d.amountPaise > 0 && d.amountPaise <= 10000000000
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.note is string && d.note.size() <= 200
        && ((d.kind == 'moneyIn' && d.type in ['Money In', 'Saved', 'Given to Home', 'Taken from Savings'])
            || (d.kind == 'expense' && d.category is string && d.category.size() > 0 && d.paidBy is string
                && (!('paidFrom' in d) || d.paidFrom in ['Me', 'Home money', 'Savings'])));
    }

    match /users/{uid}/transactions/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validTransaction(id);
    }

    match /users/{uid}/meta/settings {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.categories is list
        && request.resource.data.payModes is list
        && request.resource.data.periodStartDay is int;
    }
  }
}
